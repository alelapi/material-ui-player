{
  "name": "material-ui-player",
  "version": "3.1.0",
  "types": "dist/index.d.ts",
  "description": "React/Material-UI Audio and Video Components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook -o public"
  },
  "keywords": [
    "react",
    "material-ui",
    "mui",
    "audio",
    "video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alelapi/material-ui-player.git"
  },
  "bugs": {
    "url": "https://github.com/alelapi/material-ui-player/issues"
  },
  "homepage": "https://github.com/alelapi/material-ui-player#readme",
  "author": "Alessio Lapi",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@mui/material": ">=9.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "9.0.1",
    "@storybook/addon-links": "10.3.6",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react": "10.3.6",
    "@storybook/react-webpack5": "10.3.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "storybook": "10.3.6",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
